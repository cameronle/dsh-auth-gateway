{
	admin off
}

# Replace :19080 with the intended private port. This intentionally accepts a
# dynamic LAN IP, Tailscale IP, or MagicDNS name in Host. Restrict network reach
# with the listening interface/firewall/Tailscale ACL; never expose this plain
# HTTP listener to the public Internet.
http://:19080 {
	log {
		output stdout
		format json
	}

	@auth path /__dsh_auth/login /__dsh_auth/session /__dsh_auth/logout /healthz
	handle @auth {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:19081 {
			# Caddy is the direct private-network listener. Always overwrite any
			# identity headers supplied by the caller with the TCP peer address.
			header_up X-DSH-Client-IP {http.request.remote.host}
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
		}
	}

	handle {
		forward_auth 127.0.0.1:19081 {
			uri /verify
			header_up X-DSH-Client-IP {http.request.remote.host}
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
		}
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3080 {
			header_up Host 127.0.0.1:3080
			header_up Origin http://127.0.0.1:3080
			# Authentication is complete; do not disclose gateway credentials to DSH.
			header_up -Authorization
			header_up -Cookie
			header_up -X-DSH-Client-IP
			header_up -CF-Connecting-IP
		}
	}
}
