{
	# No runtime admin API: local processes cannot reconfigure Caddy over 2019.
	admin off
}

http://dsh.example.com:18080 {
	bind 127.0.0.1

	log {
		output stdout
		format json
	}

	@auth path /__dsh_auth/login /__dsh_auth/session /__dsh_auth/logout /healthz
	handle @auth {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:18081 {
			# cloudflared owns CF-Connecting-IP on this loopback-only origin.
			# Replace any caller-supplied internal identity with that value.
			header_up X-DSH-Client-IP {http.request.header.CF-Connecting-IP}
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
		}
	}

	handle {
		forward_auth 127.0.0.1:18081 {
			uri /verify
			header_up X-DSH-Client-IP {http.request.header.CF-Connecting-IP}
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
		}
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3080 {
			header_up Host 127.0.0.1:3080
			header_up Origin http://127.0.0.1:3080
			header_up -X-DSH-Client-IP
			header_up -CF-Connecting-IP
		}
	}
}
