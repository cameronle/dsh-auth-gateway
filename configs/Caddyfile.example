{
	# No runtime admin API: local processes cannot reconfigure Caddy over 2019.
	admin off
}

http://dsh.example.com {
	# A site address containing 127.0.0.1 would only match Host: 127.0.0.1.
	# Match every Host delivered by the Tunnel, but bind the socket to loopback.
	bind 127.0.0.1
	# cloudflared remains in the host namespace and reaches this Unix socket.
	bind unix//run/dsh-control-plane/caddy.sock

	log {
		output stdout
		format json
	}

	@auth path /__dsh_auth/login /__dsh_auth/session /__dsh_auth/logout /healthz
	handle @auth {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:18081 {
			# Cloudflare owns this header on public requests. Remove any value
			# before the auth service sees it when Caddy is called another way.
			header_up -CF-Connecting-IP
		}
	}

	handle {
		forward_auth 127.0.0.1:18081 {
			uri /verify
			header_up -CF-Connecting-IP
		}
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3080 {
			# DSH pins settings.*, credentials.*, native host actions, and
			# model discovery to a loopback authority. Requests reaching here
			# have passed gateway authentication, and DSH itself is loopback-only.
			header_up Host 127.0.0.1:3080
			header_up Origin http://127.0.0.1:3080
		}
	}
}
