LISTEN=127.0.0.1:18081
KEY_HASH=sha256:<generated-base64url-sha256-digest>
SESSION_TTL=12h
COOKIE_NAME=dsh_gateway_session

# The only transport setting. Defaults to https when omitted.
# It controls Origin validation, default-port normalization, and whether the
# session cookie receives the Secure attribute.
PUBLIC_SCHEME=https

# Optional legacy/extra restriction. Omit for dynamic domains, DHCP addresses,
# Tailscale IPs, MagicDNS names, and changing external ports.
# EXPECTED_HOST=dsh.example.com

TRUSTED_PROXY_IP=127.0.0.1
CLIENT_IP_HEADER=X-DSH-Client-IP
REQUIRE_CLIENT_IDENTITY=true

AUTH_FAILURE_BURST=5
AUTH_FAILURE_REFILL=30s
AUTH_GLOBAL_BURST=100
AUTH_GLOBAL_REFILL=200ms
AUTH_STATE_TTL=1h
AUTH_STATE_MAX_CLIENTS=10000
AUTH_CLEANUP_INTERVAL=1m
AUTH_SESSION_MAX=10000

# Used only during migration from a legacy scrypt hash.
KEY_CHECK_CONCURRENCY=2
KEY_CHECK_BURST=4
KEY_CHECK_REFILL=2s

# Future trusted-LAN/Tailscale HTTP instance only needs:
# PUBLIC_SCHEME=http
# Use a different LISTEN and COOKIE_NAME for a simultaneous second instance.
